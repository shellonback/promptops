{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PromptOps",
  "version": "2.2.0-beta.0",
  "identifier": "it.promptops.oss",
  "build": {
    "frontendDist": "../../web/dist/promptops-manager/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "cd ../web && npm run start:desktop",
    "beforeBuildCommand": "cd ../web && npm run build:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost https://github.com https://avatars.githubusercontent.com https://raw.githubusercontent.com",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://raw.githubusercontent.com",
        "frame-src": "http://localhost:* http://127.0.0.1:* https://localhost:* https://127.0.0.1:*",
        "worker-src": "'self' blob:",
        "media-src": "'self' blob: data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "license": "Apache-2.0",
    "copyright": "Copyright 2026 Shellonback S.r.l.",
    "publisher": "Shellonback S.r.l."
  }
}
