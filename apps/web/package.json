{
  "name": "promptops-web",
  "version": "2.1.7",
  "scripts": {
    "start": "ng serve --configuration=desktop-dev",
    "start:desktop": "ng serve --configuration=desktop-dev",
    "build": "node scripts/build-icons.mjs && node ../../scripts/generate-notices.mjs && ng build --configuration=desktop",
    "build:desktop": "node scripts/build-icons.mjs && node ../../scripts/generate-notices.mjs && ng build --configuration=desktop",
    "watch": "ng build --watch --configuration desktop-dev",
    "test": "ng test",
    "icons": "node scripts/build-icons.mjs",
    "notices": "node ../../scripts/generate-notices.mjs"
  },
